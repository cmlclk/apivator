# Apivator üretim ayarları. Bu dosyayı .env olarak kopyalayıp doldurun; .env'yi depoya koymayın.

# Erişim adresi (DNS bu sunucuyu göstermeli)
APIVATOR_DOMAIN=apivator.sirket.com
APIVATOR_PUBLIC_URL=https://apivator.sirket.com

# HTTPS: auto (Let's Encrypt) | files (./certs/cert.pem + key.pem) | internal (Caddy'nin kendi CA'sı)
CADDY_TLS=auto

# Güçlü ve rastgele değerler üretin, ör.:  openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# E-posta (doğrulama, şifre sıfırlama, davet, bahsetme). Office 365: smtp.office365.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=apivator@sirket.com
SMTP_FROM_NAME=Apivator

# Web'den şirket içi API'lere istek atılacaksa izin verilen ağlar (virgülle), ör.: 10.0.0.0/8, 192.168.10.0/24
PROXY_ALLOWED_NETWORKS=

# Otomatik yedek: her gün bu saatte, bu kadar gün saklanır (deploy/backups)
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
TZ=Europe/Istanbul

# İmaj etiketi (güncellemelerde sürüm takibi için)
APIVATOR_VERSION=latest
