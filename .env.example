# docker compose için örnek ortam değişkenleri. Kopyalayın: cp .env.example .env
POSTGRES_USER=apivator
POSTGRES_PASSWORD=apivator
POSTGRES_DB=apivator

# En az 32 karakter olmalı. Üretimde mutlaka değiştirin.
JWT_SIGNING_KEY=dev-only-change-me-0123456789-abcdefghijklmnop

# Web arayüzünün dışarıdan erişilen adresi (e-posta linklerinde kullanılır)
APP_PUBLIC_URL=http://localhost:8080
