{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=apivator;Username=apivator;Password=apivator"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "apivator",
    "Audience": "apivator",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "App": {
    "PublicUrl": "http://localhost:5173"
  },
  "Email": {
    "Mode": "Smtp"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "no-reply@apivator.local",
    "FromName": "Apivator"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "AllowPrivateNetworks": false,
    "AllowedNetworks": [],
    "TimeoutSeconds": 30,
    "MaxResponseBytes": 10485760
  },
  "Database": {
    "MigrateOnStartup": false
  }
